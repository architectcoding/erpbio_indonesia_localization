# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.py~

# Distribution / packaging
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
tags
# Anchored to root -- setuptools generates this file at the repo root, and
# unanchored it would case-insensitively shadow any manifest/ directory
# (core.ignorecase=true on macOS).
/MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Dependency directories
# No trailing slash -- a trailing "/" only matches real directories, not
# symlinks, so a symlinked node_modules would otherwise slip through
# untracked.
node_modules
jspm_packages

# IDEs and editors
.vscode/
.vs/
.idea/
.kdev4/
*.kdev4
*.DS_Store
.DS_Store
*.swp
*.comp.js
.wnf-lang-status
*debug.log

# Helix Editor
.helix/

# Aider AI Chat
.aider*
