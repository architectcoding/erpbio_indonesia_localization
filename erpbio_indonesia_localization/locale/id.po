msgstr "Kolom Referensi dan Nomor Faktur tidak ditemukan. Unggah daftar faktur yang diunduh dari Coretax (Excel atau CSV)."

msgid "No data rows found below the header."
msgstr "Tidak ada baris data di bawah header."

msgid "{0} of {1} rows matched a Sales Invoice."
msgstr "{0} dari {1} baris cocok dengan Faktur Penjualan."

msgid "no Referensi — cannot match to a Sales Invoice"
msgstr "tidak ada Referensi — tidak bisa dicocokkan ke Faktur Penjualan"

msgid "no submitted Sales Invoice named {0}"
msgstr "tidak ada Faktur Penjualan tersubmit bernama {0}"

msgid "row has no faktur number"
msgstr "baris tidak punya nomor faktur"

msgid "status not final yet — skipped"
msgstr "status belum final — dilewati"

msgid "will replace faktur number {0}"
msgstr "akan mengganti nomor faktur {0}"

msgid "Run Preview first."
msgstr "Jalankan Pratinjau dulu."

msgid "Applied to {0} Sales Invoices."
msgstr "Diterapkan ke {0} Faktur Penjualan."

msgid "Attach the file downloaded from Coretax first."
msgstr "Lampirkan dulu berkas yang diunduh dari Coretax."

msgid "Only .xlsx and .csv files are supported."
msgstr "Hanya berkas .xlsx dan .csv yang didukung."

